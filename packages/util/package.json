{
  "name": "@project516/ffmpeg-wasm-util",
  "version": "0.13.1",
  "description": "browser utils for @project516/*",
  "main": "./dist/cjs/index.js",
  "type": "module",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/cjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "scripts": {
    "dev": "tsc -p tsconfig-esm.json --watch",
    "lint": "eslint src",
    "clean": "rimraf dist",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:umd": "tsc -p tsconfig.cjs.json && node ../../scripts/emit-dist-package-json.mjs dist/cjs commonjs && webpack",
    "build": "pnpm run clean && pnpm run build:esm && pnpm run build:umd",
    "prepublishOnly": "pnpm run build"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Project516/ffmpeg.wasm.git"
  },
  "keywords": [
    "ffmpeg",
    "video",
    "audio",
    "transcode"
  ],
  "author": "Jerome Wu <jeromewus@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Project516/ffmpeg.wasm/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "homepage": "https://github.com/Project516/ffmpeg.wasm#readme",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "webpack": "^5.94.0",
    "webpack-cli": "^7.2.3"
  }
}
