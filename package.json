{
  "name": "root",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "lint": "pnpm run lint:root && pnpm --if-present -r run lint",
    "lint:root": "eslint tests",
    "check:doc-versions": "node scripts/check-doc-versions.mjs",
    "build": "pnpm --if-present -r run build",
    "pretest": "pnpm run build",
    "serve": "node scripts/serve.mjs 3000",
    "test": "server-test test:browser:server 3000 test:all",
    "test:all": "npm-run-all test:browser:*:*",
    "test:browser": "mocha-headless-chrome -a enable-features=SharedArrayBuffer",
    "test:browser:core:st": "pnpm run test:browser -f http://localhost:3000/tests/ffmpeg-core-st.test.html",
    "test:browser:ffmpeg:mt": "pnpm run test:browser -f http://localhost:3000/tests/ffmpeg-mt.test.html",
    "test:browser:ffmpeg:st": "pnpm run test:browser -f http://localhost:3000/tests/ffmpeg-st.test.html",
    "test:browser:server": "pnpm run serve",
    "test:node": "mocha --exit --bail -t 60000",
    "test:node:core:mt": "pnpm run test:node --require tests/test-helper-mt.js tests/ffmpeg-core.test.js",
    "test:node:core:st": "pnpm run test:node --require tests/test-helper-st.js tests/ffmpeg-core.test.js",
    "test:node:ffmpeg:st": "pnpm run test:node tests/ffmpeg-node.test.mjs",
    "test:node:ffmpeg:mt": "cross-env FFMPEG_TYPE=mt pnpm run test:node tests/ffmpeg-node.test.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@project516/ffmpeg-wasm": "workspace:*",
    "@project516/ffmpeg-wasm-core": "workspace:*",
    "@project516/ffmpeg-wasm-core-mt": "workspace:*",
    "@project516/ffmpeg-wasm-util": "workspace:*",
    "chai": "^6.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "mocha": "^12.0.2",
    "mocha-headless-chrome": "^5.1.0",
    "npm-run-all": "^4.1.5",
    "start-server-and-test": "^3.0.12"
  }
}
