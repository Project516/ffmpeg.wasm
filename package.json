{
  "name": "root",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "lint": "pnpm run lint:root && pnpm --if-present -r run lint",
    "lint:root": "eslint tests",
    "check:doc-versions": "node scripts/check-doc-versions.mjs",
    "build": "pnpm --if-present -r run build",
    "serve": "node scripts/serve.mjs 3000",
    "test:browser:playwright": "node scripts/test-browser.mjs",
    "test:node": "mocha --exit --bail -t 60000",
    "test:node:core:mt": "pnpm run test:node --require tests/test-helper-mt.js tests/ffmpeg-core.test.js",
    "test:node:core:st": "pnpm run test:node --require tests/test-helper-st.js tests/ffmpeg-core.test.js",
    "test:node:ffmpeg:st": "pnpm run test:node tests/ffmpeg-node.test.mjs",
    "test:node:ffmpeg:jspi": "pnpm run test:node tests/ffmpeg-node.test.mjs --jspi",
    "test:node:ffmpeg:mt": "pnpm run test:node tests/ffmpeg-node.test.mjs --mt",
    "test:node:helpers:args": "pnpm run test:node tests/ffmpeg-helpers-args.test.mjs",
    "test:node:helpers:st": "pnpm run test:node tests/ffmpeg-helpers.test.mjs",
    "test:node:helpers:jspi": "pnpm run test:node tests/ffmpeg-helpers.test.mjs --jspi",
    "test:node:helpers:mt": "pnpm run test:node tests/ffmpeg-helpers.test.mjs --mt",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@project516/ffmpeg-wasm": "workspace:*",
    "@project516/ffmpeg-wasm-core": "workspace:*",
    "@project516/ffmpeg-wasm-core-mt": "workspace:*",
    "@project516/ffmpeg-wasm-util": "workspace:*",
    "chai": "^6.3.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "playwright": "^1.63.0"
  }
}
