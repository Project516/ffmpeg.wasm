# Every decoder, demuxer, parser, protocol, bitstream filter and filter, with
# only a few encoders and muxers kept for extracting frames, audio and
# checksums. No encoder libraries.
FFMPEG_FLAGS="
  --enable-gpl
  --enable-zlib
  --enable-libfreetype
  --enable-libfribidi
  --enable-libass
  --enable-libzimg
  --disable-encoders
  --disable-muxers
  --enable-encoder=wrapped_avframe,rawvideo,png,mjpeg,pcm_s16le,pcm_s24le,pcm_f32le
  --enable-muxer=null,image2,image2pipe,wav,rawvideo,framecrc,framemd5,md5,crc,hash
"
FFMPEG_LIBS="
  -lz -lfreetype -lfribidi -lharfbuzz -lass -lzimg
"
# wasm-opt -O3 in emsdk 6.0.10 asserts on this module (constraint.cpp,
# approximateOr). -O2 links it.
FFMPEG_LINK_FLAGS="-O2"
