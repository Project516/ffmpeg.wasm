# The codecs and containers web video and audio use, with the encoders to
# produce them. No x265, theora or subtitle rendering.
FFMPEG_FLAGS="
  --disable-everything
  --enable-gpl
  --enable-libx264
  --enable-libvpx
  --enable-libmp3lame
  --enable-libvorbis
  --enable-libopus
  --enable-libwebp
  --enable-zlib
  --enable-decoder=h264,hevc,vp8,vp9,mpeg4,mjpeg,png,gif,webp,aac,aac_latm,mp3,mp3float,opus,vorbis,flac,alac,pcm_s16le,pcm_s24le,pcm_s32le,pcm_f32le,pcm_u8,rawvideo
  --enable-encoder=libx264,libvpx_vp8,libvpx_vp9,aac,libopus,libmp3lame,libvorbis,flac,png,mjpeg,gif,libwebp,libwebp_anim,pcm_s16le,pcm_s24le,pcm_f32le,rawvideo,wrapped_avframe
  --enable-demuxer=mov,matroska,ogg,mp3,flac,wav,aac,h264,hevc,gif,image2,image_png_pipe,image_jpeg_pipe,image_webp_pipe,concat,mpegts
  --enable-muxer=mp4,mov,webm,matroska,ogg,opus,mp3,flac,wav,gif,webp,image2,adts,rawvideo,null,framecrc,framemd5,md5
  --enable-parser=h264,hevc,vp8,vp9,aac,aac_latm,mpegaudio,opus,vorbis,flac,mjpeg,png,webp
  --enable-bsf=h264_mp4toannexb,hevc_mp4toannexb,aac_adtstoasc,extract_extradata,vp9_superframe,vp9_superframe_split
  --enable-protocol=file,pipe,data,concat
  --enable-filter=scale,aresample,aformat,format,null,anull,trim,atrim,setpts,asetpts,fps,crop,pad,transpose,hflip,vflip,rotate,volume,amix,amerge,pan,atempo,concat,overlay,split,asplit,setsar,setdar,select,aselect,fade,afade,palettegen,paletteuse
"
FFMPEG_LIBS="
  -lx264 -lvpx -lmp3lame -logg -lvorbis -lvorbisenc -lvorbisfile -lopus -lz
  -lwebpmux -lwebp -lsharpyuv
"
